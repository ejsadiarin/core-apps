    "definitions": {
        "main.ServiceStatus": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "main.SystemStats": {
            "type": "object",
            "properties": {
                "cpu": {
                    "type": "integer"
                },
                "memory": {
                    "type": "integer"
                },
                "network": {
                    "type": "object",
                    "properties": {
                        "down": {
                            "type": "string"
                        },
                        "up": {
                            "type": "string"
                        }
                    }
                },
                "storage": {
                    "type": "integer"
                },
                "temperature": {
                    "type": "integer"
                },
                "uptime": {
                    "type": "string"
                }
            }
        },
        "models.CategoryBreakdownItem": {
            "type": "object",
            "properties": {
                "category_id": {
                    "type": "string"
                },
                "category_name": {
                    "type": "string"
                },
                "color": {
                    "type": "string"
                },
                "count": {
                    "type": "integer"
                },
                "percentage": {
                    "type": "number"
                },
                "total_amount": {
                    "type": "number"
                }
            }
        },
        "models.CategoryResponse": {
            "type": "object",
            "properties": {
                "color": {
                    "type": "string"
                },
                "icon": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "models.CreateCategoryRequest": {
            "type": "object",
            "required": [
                "name"
            ],
            "properties": {
                "color": {
                    "type": "string"
                },
                "icon": {
                    "type": "string",
                    "maxLength": 50
                },
                "name": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1
                }
            }
        },
        "models.CreateExpenseRequest": {
            "type": "object",
            "required": [
                "amount",
                "description",
                "expense_date"
            ],
            "properties": {
                "amount": {
                    "description": "Will be converted to pgtype.Numeric",
                    "type": "number"
                },
                "category_id": {
                    "type": "string"
                },
                "currency": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "expense_date": {
                    "description": "YYYY-MM-DD",
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                },
                "tag_ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "models.CreateServiceRequest": {
            "type": "object",
            "required": [
                "name",
                "url"
            ],
            "properties": {
                "description": {
                    "type": "string"
                },
                "expected_status_codes": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "health_check_interval": {
                    "type": "integer",
                    "maximum": 3600
                },
                "health_check_method": {
                    "type": "string",
                    "enum": [
                        "GET",
                        "POST",
                        "HEAD"
                    ]
                },
                "icon": {
                    "type": "string",
                    "maxLength": 50
                },
