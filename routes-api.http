@host=localhost:8080
@sessionToken=your-session-token-here


### Health Check

GET {{host}}/health


### System Stats

GET {{host}}/api/system/stats


### Legacy Services

GET {{host}}/api/legacy/services


### Register

POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}


### Login

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}


### Login as Demo

POST {{host}}/api/auth/demo
Content-Type: application/json

{
  "email": "demo@coregateway.local",
  "password": "demo12345"
}


### Logout

POST {{host}}/api/auth/logout
Cookie: session_token={{sessionToken}}


### Get Current User

GET {{host}}/api/auth/me
Cookie: session_token={{sessionToken}}


### List Users

GET {{host}}/api/users
Cookie: session_token={{sessionToken}}


### Create User

POST {{host}}/api/users
Cookie: session_token={{sessionToken}}
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "password123",
  "role": "user"
}


### Get User

GET {{host}}/api/users/{user_id}
Cookie: session_token={{sessionToken}}


### Update User

PUT {{host}}/api/users/{user_id}
Cookie: session_token={{sessionToken}}
Content-Type: application/json

{
  "email": "updated@example.com"
}


### Delete User

DELETE {{host}}/api/users/{user_id}
Cookie: session_token={{sessionToken}}


### Create Service

POST {{host}}/api/services
Cookie: session_token={{sessionToken}}
Content-Type: application/json

{
  "name": "My Service",
  "url": "https://example.com",
  "description": "A test service",
  "service_type": "web",
  "health_check_interval": 60,
  "health_check_method": "GET",
  "expected_status_codes": [200],
  "timeout": 5000
}


### List Services

GET {{host}}/api/services/list
Cookie: session_token={{sessionToken}}


### Get All Services Stats

GET {{host}}/api/services/stats/all
Cookie: session_token={{sessionToken}}


### Get Service

GET {{host}}/api/services/{service_id}
Cookie: session_token={{sessionToken}}


### Update Service

PUT {{host}}/api/services/{service_id}
Cookie: session_token={{sessionToken}}
Content-Type: application/json

{
  "name": "Updated Service",
  "is_active": false
}


### Delete Service

DELETE {{host}}/api/services/{service_id}
Cookie: session_token={{sessionToken}}


### Get Service History

GET {{host}}/api/services/{service_id}/history
Cookie: session_token={{sessionToken}}


### Get Service Stats

GET {{host}}/api/services/{service_id}/stats
Cookie: session_token={{sessionToken}}


# How to use this file:
# 1. Login using the Login request to get a session_token cookie
# 2. Copy the session_token value from the response cookies
# 3. Update @sessionToken at the top of this file
# 4. For user/service endpoints, replace {user_id} and {service_id} with actual UUIDs
