@host=localhost:8080

### Health Check

GET {{host}}/health

### System Stats

GET {{host}}/api/system/stats

### Legacy Services

GET {{host}}/api/legacy/services


# ─── Auth ────────────────────────────────────────────────────────────────────

### Register

POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Login

POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "password123"
}

### Login as Demo

POST {{host}}/api/auth/demo

### Logout

POST {{host}}/api/auth/logout

### Get Current User

GET {{host}}/api/auth/me


# ─── Users ───────────────────────────────────────────────────────────────────

### List Users

GET {{host}}/api/users

### Create User

POST {{host}}/api/users
Content-Type: application/json

{
  "email": "newuser@example.com",
  "password": "password123",
  "role": "user"
}

### Get User

GET {{host}}/api/users/{user_id}

### Update User

PUT {{host}}/api/users/{user_id}
Content-Type: application/json

{
  "email": "updated@example.com"
}

### Delete User

DELETE {{host}}/api/users/{user_id}


# ─── Services ────────────────────────────────────────────────────────────────

### Create Service

POST {{host}}/api/services
Content-Type: application/json

{
  "name": "My Service",
  "url": "https://example.com",
  "description": "A test service",
  "service_type": "web",
  "health_check_interval": 60,
  "health_check_method": "GET",
  "expected_status_codes": [200],
  "timeout": 5000
}

### List Services

GET {{host}}/api/services/list

### Get All Services Stats

GET {{host}}/api/services/stats/all

### Get Service

GET {{host}}/api/services/{service_id}

### Update Service

PUT {{host}}/api/services/{service_id}
Content-Type: application/json

{
  "name": "Updated Service",
  "is_active": false
}

### Delete Service

DELETE {{host}}/api/services/{service_id}

### Get Service History

GET {{host}}/api/services/{service_id}/history

### Get Service Stats

GET {{host}}/api/services/{service_id}/stats
