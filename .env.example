# ==============================================================================
# Core Homelab Dashboard - Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the values
# ==============================================================================

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================

# PostgreSQL connection string for local development
# Format: postgresql://username:password@host:port/database?sslmode=mode
# For local Docker: postgresql://core:core@localhost:5432/core?sslmode=disable
# For NeonDB: postgresql://user:pass@host:5432/database?sslmode=require
DATABASE_URL=postgresql://core:core@localhost:5432/core?sslmode=disable

# ==============================================================================
# Redis Configuration
# ==============================================================================

# Redis connection URL for caching and sessions
# For local Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379

# ==============================================================================
# Server Configuration
# ==============================================================================

# API server port
PORT=8080

# Environment: development, staging, or production
ENV=development

# Frontend URL for CORS configuration
# For local development: http://localhost:3000
# For production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# ==============================================================================
# Authentication (Better Auth)
# ==============================================================================

# Authentication secret key (generate with: openssl rand -hex 32)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=your-auth-secret-key-here

# ==============================================================================
# Encryption
# ==============================================================================

# Encryption key for sensitive data (32 bytes for AES-256, hex encoded)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# ==============================================================================
# Optional: Third-party API Keys
# ==============================================================================

# Example placeholders for future integrations
# AI/LLM API keys (for spending insights, etc.)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Notification services
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=

# ==============================================================================
# Development Only (for local testing)
# ==============================================================================

# Enable debug logging
DEBUG=true

# Seed database with sample data on startup
SEED_DATA=false

# ==============================================================================
# Production Deployment Notes
# ==============================================================================
# When deploying to production:
# 1. Set ENV=production
# 2. Use strong, unique values for all secrets
# 3. Configure proper SSL/TLS certificates
# 4. Set up proper database backup strategy
# 5. Configure monitoring and alerting
# 6. Review CORS settings for your domain
# ==============================================================================
